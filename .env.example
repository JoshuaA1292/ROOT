# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/root_trees?retryWrites=true&w=majority
MONGODB_DB=root_trees

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
# Path to service account JSON (local dev only — use Secret Manager in Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Frontend map provider (OpenStreetMap tiles via Leaflet)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-url>.vercel.app

# Google AI Studio key — easier than Vertex AI for local dev
# Get one free at https://aistudio.google.com/app/apikey
# Either this OR GOOGLE_CLOUD_PROJECT must be set for Gemini to work
GOOGLE_AI_STUDIO_KEY=

# Gemini model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Groq fallback for Gemini quota/rate-limit failures
# Set LLM_PROVIDER=groq during demos if Gemini free-tier quota is exhausted.
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NYC Open Data (no API key required, but a token raises rate limits)
NYC_OPEN_DATA_APP_TOKEN=
NYC_DOB_PERMIT_URL=
PARKS_TREE_WORK_URL=

# Optional multi-city tree inventory feeds
PORTLAND_TREE_INVENTORY_URL=
SEATTLE_TREE_INVENTORY_URL=

# Agent Builder
AGENT_BUILDER_LOCATION=us-central1
AGENT_BUILDER_AGENT_ID=<agent-id-after-creation>

# MongoDB access mode: repository for local/dev tests, mcp for production Agent Builder path
MONGODB_ACCESS_MODE=repository
MONGODB_MCP_CONFIG_PATH=mcp/mcp.config.json

# Workspace identity mode: dev_header, iap, firebase, oauth
AUTH_MODE=dev_header

# Optional live agency submission adapters. Leave blank to use local stub mode.
NYC_PARKS_SUBMISSION_URL=
COMMUNITY_BOARD_SUBMISSION_URL=
AGENCY_SUBMISSION_API_KEY=
