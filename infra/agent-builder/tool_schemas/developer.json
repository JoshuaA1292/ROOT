{
  "openapi": "3.0.0",
  "info": { "title": "Developer Ledger Tool", "version": "1.0.0" },
  "paths": {
    "/developers/{developer_id}/ledger": {
      "get": {
        "operationId": "getDeveloperLedger",
        "summary": "Get developer replacement compliance history",
        "parameters": [
          {
            "name": "developer_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Developer ID from the permit record"
          }
        ],
        "responses": {
          "200": {
            "description": "Developer accountability ledger",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "permits_filed": { "type": "integer" },
                    "promised_replacements": { "type": "integer" },
                    "verified_surviving": { "type": "integer" },
                    "compliance_rate": { "type": "number" },
                    "violations": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
